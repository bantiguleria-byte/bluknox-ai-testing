{
  "module": "Forgot Password",
  "url": "https://staging.bluknox.com/forgot-password",
  "capturedAt": "2026-05-08",
  "elements": {
    "inputs": [
      {
        "tag": "input",
        "type": "email",
        "placeholder": "Email",
        "label": "Email",
        "antdFormItem": true,
        "playwrightLocator": "page.getByPlaceholder(/email/i).first()"
      }
    ],
    "buttons": [
      {
        "tag": "button",
        "text": "Send OTP",
        "type": "submit",
        "role": "button",
        "playwrightLocator": "page.getByRole('button', { name: /send otp|reset/i })"
      }
    ],
    "links": [
      {
        "text": "Back to Login / Sign In",
        "href": "/login",
        "playwrightLocator": "page.getByText(/back.*login|sign in/i).first()"
      }
    ],
    "otpFields": {
      "appearsAfter": "Valid email submitted",
      "selector": "input[inputmode='numeric'], input[autocomplete='one-time-code']",
      "count": 6,
      "playwrightLocator": "page.locator('input[inputmode=\"numeric\"]')"
    },
    "validationMessages": {
      "framework": "Ant Design (AntD)",
      "trigger": "onSubmit",
      "selector": ".ant-form-item-explain-error",
      "messages": {
        "emailEmpty": "Please enter Email!",
        "emailInvalid": "Please enter a valid email address",
        "emailNotFound": "Email not found or No account associated"
      }
    }
  }
}
